# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Google Places API
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Maya Payment Gateway
VITE_MAYA_PUBLIC_KEY=pk-your_maya_public_key
VITE_MAYA_SECRET_KEY=sk-your_maya_secret_key

# PayMongo Payment Gateway
VITE_PAYMONGO_PUBLIC_KEY=pk_test_your_paymongo_public_key

# SMTP & Live Email Notifications
SMTP_USER=your_email@gmail.com
SMTP_PASS="your_app_password"
SMTP_FROM="BINHI Concept <your_email@gmail.com>"
ADMIN_NOTIFICATION_EMAIL=your_email@gmail.com
VITE_ADMIN_NOTIFICATION_EMAIL=your_email@gmail.com
